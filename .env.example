OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
OPENAI_JUDGE_MODEL=gpt-5
OPENAI_SSIC_MODEL=gpt-5-mini    # cheap model used inside match_ssic for semantic mapping
ENVIRONMENT=dev                  # set to "production" on Render to hide raw error messages
RATE_LIMIT_PER_MIN=8/minute
RATE_LIMIT_PER_DAY=500/day
